#!/usr/bin/env bash

# if we have jq, use it to get the version from manifest.json
if command -v jq >/dev/null 2>&1; then
  VERSION="v$(jq -r '.version' manifest.json)"
else
  VERSION="unknown"
fi

echo "Building version $VERSION"

rm -f ./unclutter-gcal-*.zip

# Ship only what the browser loads. Nothing is rejected for carrying extra files,
# but every shipped byte is one more thing a store reviewer has to account for.
find . \
  -path '*/.*' -prune -o \
  -path './store-listing/*' -prune -o \
  -path './images/*' -prune -o \
  -name '*.zip' -prune -o \
  -name 'build' -prune -o \
  -name 'README.md' -prune -o \
  -type f -print | zip ./unclutter-gcal-${VERSION}.zip -@
